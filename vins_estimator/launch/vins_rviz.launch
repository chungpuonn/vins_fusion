<launch>
    <node name="rvizvisualisation" pkg="rviz" type="rviz" output="log" args="-d $(find vins)/../config/vins_rviz_config.rviz" />

    <!-- Argument for configuration file -->
    <arg name="config_path" default="$(find vins)/../config/ramlab_dataset_20230426Calib_ugv/ramlab_stereo_imu_config.yaml" />

    <!-- Launch VINS-Fusion node with specified configuration -->
    <node name="vins_estimator" pkg="vins" type="vins_node" output="screen" args="$(arg config_path)" />
    <node name="loop_fusion" pkg="loop_fusion" type="loop_fusion_node" output="screen" args="$(arg config_path)" />

    <!-- Republish stereo images from compressed to raw -->
    <node pkg="image_transport" type="republish" name="left_republish" args="compressed in:=/stereo/frame_left/image_raw out:=/stereo/frame_left/image_raw/republished"/>
    <node pkg="image_transport" type="republish" name="right_republish" args="compressed in:=/stereo/frame_right/image_raw out:=/stereo/frame_right/image_raw/republished"/>
    <node pkg="image_transport" type="republish" name="left_vehicle_republish" args="compressed in:=/stereo/vehicle_frame_left/image_raw out:=/stereo/vehicle_frame_left/image_raw/republished"/>
    <node pkg="image_transport" type="republish" name="right_vehicle_republish" args="compressed in:=/stereo/vehicle_frame_right/image_raw out:=/stereo/vehicle_frame_right/image_raw/republished"/>

</launch>
